        const orderMap = {
          "5.1. Introducción a Puesta Segura": 1,
          "5.2. DevOps y DevSecOps": 2,
          "5.3. Control de Versiones (Git)": 3,
          "5.4. Automatización (Build)": 4,
          "5.5. Integración Continua (CI)": 5,
          "5.6. Virtualización y Contenedores": 6,
          "5.7. Configuración de Sistemas (IaC)": 7,
          "5.8. Simulación de Fallos": 8,
          "5.9. Orquestación (Swarm)": 9
        };

        // Asignamos a cada pregunta su apartado
        quizData.forEach((q, i) => {
            if (i < 84) {
                let passed = 0;
                for (let s of sectionMap) {
                    if (i < passed + s.count) {
                        q.apartado = s.name;
                        break;
                    }
                    passed += s.count;
                }
            } else {
                q.apartado = specificMap[i];
            }
        });

        // Finalmente, ordenamos el array de preguntas de la 1 a la 100 de forma lógica
        quizData.sort((a, b) => orderMap[a.apartado] - orderMap[b.apartado]);
    }

    // Ejecutamos la clasificación antes de nada
    prepareAndSortQuestions();

    // 3. LÓGICA DE LA INTERFAZ
    let currentQuestionIndex = 0;
    let score = 0;
    
    const questionTextElement = document.getElementById('question-text');
    const optionsContainer = document.getElementById('options-container');
    const feedbackBox = document.getElementById('feedback-box');
    const nextBtn = document.getElementById('next-btn');
    const scoreElement = document.getElementById('score');
    const progressText = document.getElementById('progress-text');
    const quizContent = document.getElementById('quiz-content');
    const endScreen = document.getElementById('end-screen');
    const finalScore = document.getElementById('final-score');
    
    const letters = ['A', 'B', 'C', 'D'];

    // Función para renderizar la barra superior de apartados
    function renderSectionProgress() {
        const progressContainer = document.getElementById('section-progress');
        progressContainer.innerHTML = ''; 

        // Extraemos nombres únicos de apartados preservando el orden numérico
        const sections = [...new Set(quizData.map(q => q.apartado))];
        const currentSection = quizData[currentQuestionIndex].apartado;

        sections.forEach(sec => {
            const badge = document.createElement('span');
            badge.className = 'section-badge';
            if (sec === currentSection) {
                badge.classList.add('active');
            }
            badge.innerText = sec; 
            progressContainer.appendChild(badge);
        });
    }

    function loadQuestion() {
        feedbackBox.style.display = 'none';
        nextBtn.style.display = 'none';
        optionsContainer.innerHTML = '';
        
        // Actualizamos las burbujas de apartados
        renderSectionProgress();
        
        const currentData = quizData[currentQuestionIndex];
        
        progressText.innerText = `Pregunta ${currentQuestionIndex + 1} de ${quizData.length}`;
        questionTextElement.innerText = currentData.question;
        
        currentData.options.forEach((option, index) => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerHTML = `<strong>${letters[index]})</strong> ${option.text}`;
            btn.onclick = () => selectAnswer(btn, option.correct, currentData.feedback);
            optionsContainer.appendChild(btn);
        });
    }

    function selectAnswer(selectedBtn, isCorrect, feedbackHtml) {
        const allButtons = optionsContainer.querySelectorAll('.option-btn');
        allButtons.forEach(btn => btn.disabled = true);

        if(isCorrect) {
            selectedBtn.classList.add('correct');
            score++;
            scoreElement.innerText = score;
            feedbackBox.innerHTML = `<strong>¡Muy bien! ¡Acierto!</strong><br><br>${feedbackHtml}`;
            feedbackBox.className = 'feedback-correct';
        } else {
            selectedBtn.classList.add('incorrect');
            allButtons.forEach(btn => {
                const btnData = quizData[currentQuestionIndex].options.find(
                    o => btn.innerHTML.includes(o.text)
                );
                if(btnData && btnData.correct) {
                    btn.classList.add('correct');
                }
            });
            feedbackBox.innerHTML = `<strong>Respuesta incorrecta.</strong><br><br>${feedbackHtml}`;
            feedbackBox.className = 'feedback-incorrect';
        }
        
        feedbackBox.style.display = 'block';
        nextBtn.style.display = 'block';
        
        // Autoscroll suave hacia el botón de continuar
        setTimeout(() => {
            nextBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 100);
    }

    function nextQuestion() {
        currentQuestionIndex++;
        
        if(currentQuestionIndex < quizData.length) {
            loadQuestion();
        } else {
            quizContent.style.display = 'none';
            endScreen.style.display = 'block';
            finalScore.innerText = score;
            document.getElementById('total-questions-text').innerText = quizData.length;
        }
    }

    // Iniciamos la aplicación
    window.onload = loadQuestion;
</script>

